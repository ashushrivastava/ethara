# Copy to `.env` locally. On Railway, set these in Project → Variables (do not commit secrets).
#
# MongoDB Atlas: Database → Connect → Drivers → copy URI.
# Use database name `teamtasks` in the path, e.g. ...mongodb.net/teamtasks?...
# URL-encode special characters in the password (@ → %40, etc.).

DATABASE_URL="mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/teamtasks?retryWrites=true&w=majority&appName=Cluster0"

# Long random string for JWT signing (e.g. openssl rand -base64 32)
JWT_SECRET="replace-with-a-long-random-secret"

# Railway sets PORT automatically; optional locally.
PORT=4000
